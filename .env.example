####################################################################################
#  .env.example — GENERATED FILE, DO NOT EDIT BY HAND
#
#  This is a copy of .env. Edit .env, then run `npm run env:sync`.
#  `npm run env:check` fails if the two ever differ.
#
#  ⚠  It currently contains REAL credentials, identical to .env, so it is
#     committed here. Before publishing a public repo, either replace the
#     secrets below or add both files to .gitignore. See the "GOING PUBLIC"
#     section at the bottom of .gitignore.
####################################################################################

####################################################################################
#  projectname-api — environment
#
#  THE FILE HAS TWO PARTS
#
#    PART 1 — REQUIRED      The app refuses to boot without these.
#    PART 2 — OPTIONAL      Each one has a stated default. Leave it alone and the
#                           app runs; fill it in and that feature switches on.
#
#  HOW TO CHANGE SOMETHING
#    1. Edit the value here.
#    2. Run `npm run env:sync`   — keeps .env.example identical.
#    3. Run `npm run doctor`     — checks the change actually works.
#    4. Restart the server (npm run dev).
#
#  !! TRACKED BY GIT ON PURPOSE — it holds real values. Fine for a private  !!
#  !! repo. For a public one, see the "GOING PUBLIC" section of .gitignore.  !!
#
#  GENERATE A SECRET
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
####################################################################################


####################################################################################
#  PART 1 — REQUIRED
#
#  The app THROWS AT BOOT if any of these is missing or malformed. There is no
#  default for any of them, on purpose: a half-configured API that boots is
#  worse than one that refuses to start.
####################################################################################

# ── Database ──────────────────────────────────────────────────────────────────
#
# ⚠  THE MOST IMPORTANT LINE IN THIS FILE.
#
#   WHICH URL TO USE
#     Running on Render  → INTERNAL URL.   …@dpg-xxxx
#                              Faster: never leaves Render's private network.
#     Running on your PC → EXTERNAL URL.   …@dpg-xxxx.<region>-postgres.render.com
#
#   WHY INTERNAL CANNOT BE USED LOCALLY
#     The internal hostname only resolves inside Render's network. From your
#     machine it fails with "database does not exist", which is really a DNS
#     problem wearing a misleading error.
#
#   connection_limit  Caps pooled connections. Free Render Postgres allows very
#                     few, and every request opens up to 2 (see TRACKING_ENABLED
#                     in Part 2). Raise only if your plan allows it.
DATABASE_URL=postgresql://projectnamedb_user:oVbNvJjECJqIlq1Lr1ci3WL2syfE6xxI@dpg-db0tug6gekts73b9aj6g-a.singapore-postgres.render.com:5432/projectnamedb?schema=public&connection_limit=5

# ── JWT signing secrets ───────────────────────────────────────────────────────
#
# ⚠  ROTATE BOTH if they ever leave this repo. Anyone holding them can mint a
#    valid access token for any account, including SUPER_ADMIN.
# ⚠  Changing either one invalidates every issued token — everyone logs in
#    again. That is why APP_NAME (Part 2) is also worth pinning.
# Minimum 16 characters. These two must differ from each other.
JWT_ACCESS_SECRET=5dc4d14b9c7b88bf621f493837e8e9a76ff7180385e34048bcf46edf8e9410ff233180b63097b00dc451920f4360e53b
JWT_REFRESH_SECRET=2c018ec590462a6e2b3ebdcd6430d3831a4e731a14dc9ec44584a64cb3c14422075dc021d39433418f1e104f1807c813

# How long each token stays valid. 15m / 7d are sane.
# DEFAULT: 15m / 7d
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d


####################################################################################
#  PART 2 — OPTIONAL
#
#  Every value below has a working default, listed in the comment. The app boots
#  with all of them empty. Fill one in and that feature comes alive; `npm run
#  doctor` tells you which ones are on.
####################################################################################

# ── Runtime ───────────────────────────────────────────────────────────────────

# development | test | production
# DEFAULT: development
# ⚠  production = strict CORS, secure cookies, no OTP codes in logs. Set it on
#    Render. Leaving it as development in production opens CORS to every origin
#    while still sending credentialed cookies.
NODE_ENV=development

# Render injects PORT itself. Locally 5000 is fine.
# DEFAULT: 5000
PORT=5000

# The base URL Swagger's "Try it out" calls. Leave EMPTY locally — it then falls
# back to http://localhost:$PORT/api/v1, which is what a developer wants.
# ⚠  ON RENDER SET THIS TO https://<your-service>.onrender.com/api/v1
#    Without it the docs page loads fine but every "Try it out" is sent to
#    localhost:5000 on the VISITOR's own machine, so all of them fail.
# DEFAULT: empty (derived from PORT)
PUBLIC_API_URL=https://projectname-api.onrender.com

# Also becomes the JWT issuer/audience. CHANGING IT LOGS EVERYONE OUT.
# DEFAULT: projectname
APP_NAME=projectname

# fatal | error | warn | info | debug | trace | silent
# DEFAULT: info — use info on Render so you can see request logs.
LOG_LEVEL=info


# ── OTP: the master switch ────────────────────────────────────────────────────
#
# ★ THIS IS THE ON/OFF SWITCH FOR THE WHOLE OTP SYSTEM ★
#
#   true  (DEFAULT)
#         Registration demands a code. The account is only written to the
#         database AFTER the code is verified — an unverified signup never
#         becomes a row. Login additionally refuses any account with no
#         verified contact.
#
#   false
#         No code is requested and none is checked. Registration creates the
#         account immediately, and login does not care about verification.
#         Use this when you have no provider and just want to click through the
#         app. NEVER ship it.
#
#   Why the default is true: it is the secure choice, and the app also refuses
#   to *enforce* codes when no provider is configured, so a fresh clone is not
#   locked out of its own login screen.
#
#   To use it, see the provider block just below.
OTP_REQUIRED=true

# Send codes by SMS as well as email. Needs MSG91_* below.
# Without it a phone-number signup gets no code at all, only a log line.
# DEFAULT: false
OTP_SMS_ENABLED=false

# Fixed code for local testing — 111111 makes every OTP predictable.
# ⚠  EMPTY THIS ON RENDER. A non-empty value together with NODE_ENV=production
#    is a boot error on purpose: a known code would let anyone log in as any
#    account. It is not a bypass — the code is still hashed, still expires in
#    10 minutes, and is still capped at 3 attempts.
# DEFAULT: empty (random codes)
OTP_STATIC_CODE=111111


# ── Email delivery ───────────────────────────────────────────────────────────
#
# ⚠  YOU CAN SKIP THIS ENTIRELY WHILE BUILDING.
#
#    With nothing set here, /auth/sendOtp still returns 200 but no mail goes
#    out — the code is written to the application log instead. Pair that with
#    OTP_STATIC_CODE=111111 (above) and the whole signup flow works offline:
#    the code is 111111 and it is printed in the terminal.
#    That is why it lives in the OPTIONAL section.
#
#    `npm run doctor` fails on an unconfigured provider so you are never left
#    guessing whether a real mail went out.
#
#    Fill this in when you are ready for a code to reach a real inbox.
#
# DEFAULT: all empty — nothing is sent, codes are only visible in the log
#
# ── Option A: Brevo — 300 emails/day ─────────────────────────────────────────
#   https://app.brevo.com → Account → SMTP & API → API Keys
#   Takes priority over the SMTP block below when set, because it needs no
#   password-manager entry and no open relay — just one key.
BREVO_API_KEY=
# The address the mail is sent FROM. Must be a verified sender in Brevo.
BREVO_FROM_EMAIL=
# Display name on the From line. Falls back to MAIL_FROM_NAME when empty.
BREVO_FROM_NAME=ProjectName


# ── Option B: any SMTP host ──────────────────────────────────────────────────
# Used only when BREVO_API_KEY is empty. Host, port and the TLS flag are
# pre-filled for a normal STARTTLS server; Gmail additionally needs an App
# Password rather than the account password, and any other host needs its own
# credentials from its dashboard.
SMTP_HOST=
SMTP_PORT=587
# true only for port 465 (implicit TLS). 587 uses STARTTLS, so false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The From header recipients see.
MAIL_FROM_NAME=ProjectName
MAIL_FROM_EMAIL=no-reply@projectname.com


# ── SMS provider: MSG91 ───────────────────────────────────────────────────────
#
# https://msg91.com → Dashboard → API Keys
# Free tier includes about 5,000 SMS.
#
# ⚠  In India a sender id MUST be a DLT-registered template header, and
#    MSG91_TEMPLATE_ID must be a DLT-approved template whose body contains an
#    {{0}} placeholder for the code. Without both, every send is rejected with
#    a 4xx from the API — this is a regulatory rule, not a setting.
#
# DEFAULT: all empty — SMS is switched off
MSG91_AUTHKEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Country code the 10-digit numbers belong to.
# DEFAULT: 91
MSG91_COUNTRY_CODE=91


# ── Media: Cloudinary ─────────────────────────────────────────────────────────
#
# ⚠  Render's disk is EPHEMERAL. Anything written to disk is lost on every
#    deploy and restart, so media must go to Cloudinary. Without these three
#    the API boots but every upload route returns 503.
#
# The API key must be the account-level **Root** key. Cloudinary also issues
# feature-scoped keys ("moderation", "mediaflows_…") that cannot upload.
# Get them from: Cloudinary → Settings → API Keys
# DEFAULT: all empty — uploads return 503
CLOUDINARY_CLOUD_NAME=dt8hnsz29
CLOUDINARY_API_KEY=876234191881745
CLOUDINARY_API_SECRET=sHo6OHYgGwGujC21Jf9IzPPpi9M

# Top-level folder in your media library. Uploads land in <folder>/<kind>.
# DEFAULT: projectname
CLOUDINARY_FOLDER=projectname


# ── Background jobs: Redis + BullMQ ───────────────────────────────────────────
#
# ⚠  LEAVE REDIS_URL EMPTY AND YOU MUST SET QUEUE_ENABLED=false, or the app
#    refuses to boot ("REDIS_URL is required when QUEUE_ENABLED=true").
# With Redis absent: background jobs are dropped and rate limiting falls back
# to per-instance in-memory counters.
# Render Key Value, or Upstash / Redis Cloud.
# DEFAULT: empty — no Redis
REDIS_URL=

# Namespaces every Redis key so several apps can share one instance.
# DEFAULT: projectname
REDIS_PREFIX=projectname

# Namespace for the BullMQ queue names. DEFAULT: projectname
QUEUE_PREFIX=projectname

# false = jobs never queued (safe without Redis)
# true  = email / notification / payout / cleanup jobs need Redis
# DEFAULT: true — so set this to false if you have no Redis
QUEUE_ENABLED=false

# false = this process only serves HTTP
# true  = also runs BullMQ workers and cron. Needs Redis.
# Run this on ONE instance only, otherwise jobs run twice.
# DEFAULT: true
WORKER_ENABLED=false


# ── CORS: which browser origins may call this API ─────────────────────────────
#
# Comma separated. NO wildcards, NO trailing slash, no quotes.
# ⚠  In production an empty list means every browser origin is rejected and the
#    frontend looks completely broken. A `*` is a boot error in production.
# While NODE_ENV=development every origin is allowed regardless of this line.
# DEFAULT: empty
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Socket.IO. Falls back to CORS_ORIGINS when empty.
# DEFAULT: empty
SOCKET_CORS_ORIGINS=


# ── Super admin (created by `npm run seed`) ───────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@projectname.com

# ⚠  THIS IS THE DEFAULT FROM THE CODE AND `npm run doctor` FLAGS IT.
#    The seed only sets this on first run, so editing it here does NOT change
#    the password already in the database. Pick something unique before going
#    live.
# DEFAULT: SuperSecret@123
SUPER_ADMIN_PASSWORD=SuperSecret@123


# ── Tracking + rate limiting ──────────────────────────────────────────────────
#
# ⚠  Every request runs 2 extra database queries (device + session lookup).
#    On a free Render Postgres this is usually the first thing to time out.
#    false = skip them, and /api/v1/health stops touching the database.
# DEFAULT: true
TRACKING_ENABLED=true

# GeoIP lookup from the request IP. Turn off to skip loading the GeoLite data.
# DEFAULT: true
GEO_LOOKUP_ENABLED=true

# ⚠  Setting this to false also disables the 1-per-minute OTP send limit, which
#    is a brute-force guard. Leave it true.
# DEFAULT: true
RATE_LIMIT_ENABLED=true


# ── Transport encryption ──────────────────────────────────────────────────────
#
# AES-256-GCM on request/response bodies. Extra work for very little gain since
# TLS already encrypts the wire, and the client has to support it too.
# DEFAULT: false
ENCRYPTION_ENABLED=false

# ⚠  Must be EXACTLY 64 hex characters, and it must NEVER change once data
#    exists — anything encrypted with an old key becomes unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DEFAULT: empty
ENCRYPTION_KEY=5e3aa85f501e61f73af87674864dd38aecc2ce29470326fd58560f7d6977c039


# ── Local PGlite — `npm run db:up` only, never used on Render ─────────────────
#
# PGlite is an in-process Postgres for offline development. It lives in
# pglite-data/ (git-ignored) and serves one connection at a time.
PGLITE_PORT=5432
PGLITE_HOST=127.0.0.1
PGLITE_DATA_DIR=pglite-data

# ⚠  Must stay false when DATABASE_URL points at a real PostgreSQL server.
#    true makes Prisma serialise every query behind one promise, which looks
#    exactly like a deadlock under load.
# DEFAULT: false
PGLITE_MODE=false


# ── Seed ──────────────────────────────────────────────────────────────────────
#
# Whether `npm run seed` also creates demo vendors, products and coupons.
# The super admin, the settings and the permission matrix are seeded regardless.
# Safe to run repeatedly — every write is an upsert.
# DEFAULT: true
SEED_DEMO_DATA=true


# ── Declared but not yet read by any code ─────────────────────────────────────
#
# Listed so you know they are safe to ignore until a payment or shipping module
# lands. Filling them in changes nothing today.
# DEFAULT: all empty
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPING_PARTNER_WEBHOOK_SECRET=
FCM_SERVER_KEY=
FCM_ENABLED=false
