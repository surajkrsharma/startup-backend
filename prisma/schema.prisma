model PageView {
  id          String   @id @default(cuid())
  sessionKey  String
  sessionId   String?
  pageUrl     String
  pageTitle   String   @default("")
  timeOnPage  Int      @default(0)
  scrollDepth Int      @default(0)
  referrer    String   @default("")
  deviceType  String   @default("")
  platform    Platform @default(WEB)
  geo         Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([sessionKey])
  @@index([pageUrl])
  @@index([createdAt])
  @@index([platform])
}

model Event {
  id         String   @id @default(cuid())
  sessionKey String   @default("")
  name       String
  meta       Json     @default("{}")
  deviceId   String   @default("")
  userId     String   @default("")
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionKey])
  @@index([userId])
}

model CrashLog {
  id           String   @id @default(cuid())
  deviceId     String   @default("")
  platform     Platform @default(WEB)
  appVersion   String   @default("")
  errorMessage String   @default("")
  errorType    String   @default("")
  stack        String   @default("")
  breadcrumbs  Json     @default("[]")
  meta         Json     @default("{}")
  sessionKey   String   @default("")
  userId       String   @default("")
  createdAt    DateTime @default(now())

  @@index([deviceId])
  @@index([platform, createdAt])
  @@index([createdAt])
}

model Funnel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps FunnelStep[]

  @@index([isActive])
}

model FunnelStep {
  id        String @id @default(cuid())
  funnelId  String
  name      String
  eventName String
  sortOrder Int    @default(0)
  count     Int    @default(0)
  dropOff   Int    @default(0)

  funnel      Funnel             @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  conversions FunnelConversion[]

  @@index([funnelId, sortOrder])
