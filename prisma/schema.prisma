model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String
  isPublic  Boolean  @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

model RolePermission {
  id         String   @id @default(cuid())
  role       Role
  permission String
  isAllowed  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
}

model AuditLog {
  id               String      @id @default(cuid())
  actorId          String?
  actorRole        String      @default("")
  action           AdminAction
  entity           String
  entityId         String      @default("")
  description      String      @default("")
  changes          Json        @default("{}")
  meta             Json        @default("{}")
  ip               String      @default("")
  userAgent        String      @default("")
  impersonatedById String?
  requestId        String      @default("")
  createdAt        DateTime    @default(now())

  actor  User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("ImpersonationTarget", fields: [impersonatedById], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String   @default("")
  entityId  String   @default("")
  meta      Json     @default("{}")
  ip        String   @default("")
  userAgent String   @default("")
  deviceId  String   @default("")
  requestId String   @default("")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  secretHash  String
  prefix      String    @default("")
  scopes      String[]  @default([])
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  usageCount  Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([isActive])
  @@index([createdAt])
}

model WebhookEndpoint {
  id           String          @id @default(cuid())
  url          String
  events       String[]        @default([])
  secret       String
  provider     WebhookProvider @default(CUSTOM)
  isActive     Boolean         @default(true)
  failureCount Int             @default(0)
  lastFiredAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  logs WebhookLog[]

  @@index([isActive])
}

model WebhookLog {
  id          String          @id @default(cuid())
  endpointId  String?
  direction   String          @default("INBOUND")
  provider    WebhookProvider @default(CUSTOM)
  event       String          @default("")
  eventId     String          @default("")
  payload     Json            @default("{}")
  signature   String          @default("")
  statusCode  Int             @default(0)
  isProcessed Boolean         @default(false)
  error       String          @default("")
  durationMs  Int             @default(0)
  createdAt   DateTime        @default(now())

  endpoint WebhookEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([endpointId])
  @@index([direction])
  @@index([createdAt])
}

model BulkJob {
  id           String    @id @default(cuid())
  jobId        String    @unique
  type         String
  fileName     String    @default("")
  fileUrl      String    @default("")
  totalRows    Int       @default(0)
  successCount Int       @default(0)
  failCount    Int       @default(0)
  errors       Json      @default("[]")
  status       JobStatus @default(QUEUED)
  vendorId     String?
  createdById  String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([vendorId])
  @@index([createdAt])
}

model FailedJob {
  id           String    @id @default(cuid())
  queue        String
  jobName      String
  jobId        String
  payload      Json      @default("{}")
  error        String    @default("")
  attemptsMade Int       @default(0)
  replayCount  Int       @default(0)
  status       String    @default("PENDING")
  lastErrorAt  DateTime  @default(now())
  replayedAt   DateTime?
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([queue, jobId])
  @@index([status, createdAt])
  @@index([queue])
  @@index([jobName])
}

model ReportSchedule {
  id          String    @id @default(cuid())
  name        String
  reportType  String
  cron        String
  recipients  String[]  @default([])
  format      String    @default("CSV")
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model SearchLog {
  id          String   @id @default(cuid())
  userId      String?
  sessionKey  String   @default("")
  term        String
  resultCount Int      @default(0)
  hasResults  Boolean  @default(true)
  filters     Json     @default("{}")
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([term])
  @@index([hasResults])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  TRACKING / ANALYTICS
// ═══════════════════════════════════════════════════════════════════════════

model VisitorLog {
  id         String   @id @default(cuid())
  sessionKey String
  sessionId  String?
  deviceId   String   @default("")
  userId     String?
  eventType  String
  eventName  String   @default("")
  eventData  Json     @default("{}")
  pageUrl    String   @default("")
  referrer   String   @default("")
  utm        Json     @default("{}")
  geo        Json     @default("{}")
  platform   Platform @default(WEB)
