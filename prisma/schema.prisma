  @@index([isActive])
}

model Dropdown {
  id        String   @id @default(cuid())
  type      String
  label     String   @default("")
  value     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, value])
  @@index([type, isActive])
}

model Translation {
  id        String   @id @default(cuid())
  locale    String
  key       String
  value     String
  namespace String   @default("common")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, key, namespace])
  @@index([locale])
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  symbol    String   @default("")
  decimals  Int      @default(2)
  rate      Float    @default(1.0)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model TaxConfig {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  percent     Float    @default(0.0)
  cgstPercent Float    @default(0.0)
  sgstPercent Float    @default(0.0)
  igstPercent Float    @default(0.0)
  isInclusive Boolean  @default(false)
  vendorId    String?
  stateCode   String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([vendorId])
}

model Country {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  dialCode String  @default("+91")
  currency String  @default("INR")
  isActive Boolean @default(true)
  states   State[]

  @@index([isActive])
}

model State {
  id          String  @id @default(cuid())
  countryCode String
  code        String  @unique
  name        String
  isActive    Boolean @default(true)
  cities      City[]

  country Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@index([countryCode])
}

model City {
  id            String  @id @default(cuid())
  stateCode     String
  name          String
  pincode       String  @default("")
  latitude      Float   @default(0.0)
  longitude     Float   @default(0.0)
  isServiceable Boolean @default(true)
  isActive      Boolean @default(true)

  state State @relation(fields: [stateCode], references: [code], onDelete: Cascade)

  @@index([stateCode])
  @@index([pincode])
}

// ═══════════════════════════════════════════════════════════════════════════
//  SHIPPING / DELIVERY
// ═══════════════════════════════════════════════════════════════════════════

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  countries String[] @default([])
  states    String[] @default([])
  pincodes  String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  methods ShippingMethod[]

  @@index([isActive])
}

model ShippingMethod {
  id           String   @id @default(cuid())
  zoneId       String?
  name         String
  code         String   @unique
  description  String   @default("")
  baseCharge   Float    @default(0.0)
  perKgCharge  Float    @default(0.0)
  freeAbove    Float    @default(0.0)
  minDays      Int      @default(1)
  maxDays      Int      @default(7)
  isCodAllowed Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  zone      ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  shipments Shipment[]

  @@index([zoneId])
  @@index([isActive])
}

model ShippingPartner {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  apiUrl    String   @default("")
  apiKey    String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]

  @@index([isActive])
}

model Shipment {
  id              String         @id @default(cuid())
  subOrderId      String
  orderId         String
  methodId        String?
  partnerId       String?
  awb             String         @default("")
  trackingUrl     String         @default("")
  status          ShipmentStatus @default(PENDING)
  weight          Float          @default(0.0)
  charge          Float          @default(0.0)
  pickupAddress   Json           @default("{}")
  deliveryAddress Json           @default("{}")
  estimatedDays   Int            @default(0)
  shippedAt       DateTime?
  deliveredAt     DateTime?
  remarks         String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subOrder   SubOrder         @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method     ShippingMethod?  @relation(fields: [methodId], references: [id], onDelete: SetNull)
  partner    ShippingPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  deliveries Delivery[]

  @@index([subOrderId])
  @@index([orderId])
  @@index([awb])
  @@index([status])
}

model DeliveryBoy {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  phone          String   @default("")
  email          String   @default("")
  vehicleType    String   @default("BIKE")
  vehicleNo      String   @default("")
  zoneId         String?
  isActive       Boolean  @default(true)
  currentLoad    Int      @default(0)
  totalDelivered Int      @default(0)
  rating         Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([isActive])
}

model Delivery {
  id            String         @id @default(cuid())
  shipmentId    String
  subOrderId    String
  deliveryBoyId String?
  status        ShipmentStatus @default(PENDING)
  deliveryOtp   String         @default("")
  otpVerifiedAt DateTime?
  latitude      Float          @default(0.0)
  longitude     Float          @default(0.0)
  remarks       String         @default("")
  pickupCode    String         @default("")
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shipment    Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  subOrder    SubOrder     @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  deliveryBoy DeliveryBoy? @relation(fields: [deliveryBoyId], references: [id], onDelete: SetNull)

  @@index([deliveryBoyId])
  @@index([subOrderId])
  @@index([status])
}

